---
import '../styles/flow.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yoonjae Hwang — Forward Deployed Engineer, ASM',
  description =
    "Forward Deployed Engineer in Product Intelligence at ASM, applying data analytics and machine learning to semiconductor process optimization. Previously 5G core at Ericsson and graduate research at USC.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
