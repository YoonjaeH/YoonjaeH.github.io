---
const navLinks = [
  { label: 'Research', href: '#research' },
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Publications', href: '#publications' },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-zinc-800/50 bg-[#080808]/85 backdrop-blur-sm"
>
  <nav class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between">
    <a
      href="#"
      class="font-mono text-xs text-zinc-500 hover:text-zinc-300 transition-colors tracking-wide"
    >
      yoonjae@usc.edu
    </a>
    <ul class="flex items-center gap-0.5">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="px-3 py-1.5 text-xs text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/60 rounded-md transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
