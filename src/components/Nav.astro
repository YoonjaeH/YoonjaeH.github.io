---
const navLinks = [
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#log-analyzer' },
  { label: 'Publications', href: '#icccn' },
  { label: 'Skills', href: '#skills' },
];

const participants = [
  { lane: 'industry', label: 'Industry', href: '#samsung' },
  { lane: 'self', label: 'Yoonjae Hwang', href: '#top' },
  { lane: 'research', label: 'Research', href: '#sim2real' },
];
---

<header class="site-header">
  <div class="wrap">
    <div class="site-header__bar">
      <a href="#top" class="site-header__home">Yoonjae Hwang</a>
      <nav class="site-header__nav" aria-label="Sections">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a
          href="/Yoonjae_Hwang_CV.pdf"
          download="Yoonjae_Hwang_CV.pdf"
          class="btn btn--primary btn--sm"
        >
          Download CV
        </a>
      </nav>
    </div>
    <div class="participants lanes" aria-label="Lifelines">
      {
        participants.map((p) => (
          <a href={p.href} class="participant" data-lane={p.lane}>
            {p.label}
          </a>
        ))
      }
    </div>
  </div>
</header>
