---
const participants = [
  { lane: 'industry', label: 'Industry' },
  { lane: 'self', label: 'Yoonjae Hwang' },
  { lane: 'research', label: 'Research' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="participants lanes" aria-hidden="true">
      {
        participants.map((p) => (
          <span class="participant" data-lane={p.lane}>
            {p.label}
          </span>
        ))
      }
    </div>
    <div class="site-footer__row">
      <span>&copy; 2026 Yoonjae Hwang</span>
      <nav aria-label="Contact">
        <a href="mailto:yoonjae@usc.edu">yoonjae@usc.edu</a>
        <a href="https://github.com/YoonjaeH" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
