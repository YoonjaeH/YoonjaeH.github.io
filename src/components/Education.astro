---
const schools = [
  {
    institution: 'University of Southern California',
    degree: 'Master of Science in Computer Science',
    period: 'Aug 2025 — Present',
    location: 'Los Angeles, CA',
  },
  {
    institution: 'University of Illinois at Urbana-Champaign',
    degree: 'B.S. in Materials Engineering · Minor in Computer Science',
    period: 'Aug 2017 — May 2023',
    location: 'Champaign, IL',
  },
];
---

<section class="py-14 px-6 border-t border-zinc-800/50">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-xs font-mono text-zinc-600 uppercase tracking-widest mb-8">Education</h2>
    <div class="space-y-5">
      {
        schools.map((school) => (
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
            <div>
              <div class="text-zinc-200 font-medium">{school.institution}</div>
              <div class="text-sm text-zinc-500 mt-0.5">{school.degree}</div>
            </div>
            <div class="font-mono text-xs text-zinc-600 shrink-0 sm:text-right pt-0.5">
              {school.period}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
