    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/Yoonjae_Hwang_CV.pdf"
        download="Yoonjae_Hwang_CV.pdf"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-zinc-50 text-zinc-950 text-sm font-medium rounded-lg hover:bg-white transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"
          ></path>
