---

<section class="pt-36 pb-24 px-6">
  <div class="max-w-3xl mx-auto">
    <!-- Status badge -->
    <div class="mb-7">
      <span
        class="inline-flex items-center gap-2 font-mono text-xs text-sky-400 bg-sky-950/50 border border-sky-800/60 rounded-full px-3.5 py-1.5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
        USC MSCS &middot; F-1 Student &middot; Open to Research Collaboration
      </span>
    </div>

    <!-- Name -->
    <h1 class="text-5xl sm:text-6xl font-semibold text-zinc-50 tracking-tight leading-none mb-5">
      Yoonjae Hwang
    </h1>

    <!-- Tagline -->
    <p class="text-xl text-zinc-400 font-light mb-2 leading-relaxed">
      Master of Science in Computer Science
    </p>
    <p class="text-base text-zinc-500 mb-10 leading-relaxed max-w-2xl">
      Researcher in Distributed Systems &amp; Multi-Agent Robotics at the University of Southern
      California. Previously Software Engineer at Ericsson, driving 5G core network optimizations
      for Verizon and AT&amp;T.
    </p>

    <!-- Contact row -->
    <div class="flex flex-wrap gap-x-6 gap-y-2.5 mb-10 text-sm text-zinc-500">
      <a
        href="mailto:yoonjae@usc.edu"
        class="flex items-center gap-1.5 hover:text-sky-400 transition-colors"
      >
        <svg
          class="w-3.5 h-3.5 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
          ></path>
        </svg>
        yoonjae@usc.edu
      </a>

      <span class="flex items-center gap-1.5 text-zinc-600">
        <svg
          class="w-3.5 h-3.5 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
          ></path>
        </svg>
        Los Angeles, CA
      </span>

      <a
        href="https://github.com/YoonjaeH"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 hover:text-sky-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        YoonjaeH
