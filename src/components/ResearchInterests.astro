---
const interests = [
  'Multi-Agent Simulation',
  'Digital-Twin Technology',
  'Distributed Systems',
  'Efficient Machine Learning',
  'Sim-to-Real Transfer',
  'Submodular Optimization',
  'O-RAN / 5G Edge',
];
---

<section id="research" class="py-14 px-6 border-t border-zinc-800/50">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-xs font-mono text-zinc-600 uppercase tracking-widest mb-8">
      Research Interests
    </h2>
    <div class="flex flex-wrap gap-2">
      {
        interests.map((interest) => (
          <span class="px-3.5 py-1.5 text-sm text-zinc-300 border border-zinc-700/60 rounded-full bg-zinc-900/40 hover:border-sky-600/50 hover:text-sky-300 transition-colors cursor-default">
            {interest}
          </span>
        ))
      }
    </div>
  </div>
</section>
