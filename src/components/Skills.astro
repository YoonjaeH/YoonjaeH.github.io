---
const skillSets = [
  {
    title: 'Software',
    groups: [
      {
        label: 'Languages & Tools',
        skills: ['Python', 'C++', 'Go', 'Erlang', 'TypeScript', 'PyTorch', 'React', 'Next.js', 'SQL', 'Bash'],
      },
      {
        label: 'Cloud & Infrastructure',
        skills: ['AWS', 'Docker', 'Kubernetes', 'CI/CD', 'Git / GitHub', 'RabbitMQ', 'REST API'],
      },
    ],
  },
  {
    title: 'Microfabrication & Microstructure Analysis',
    groups: [
      {
        label: 'Fabrication',
        skills: ['Oxidation', 'Photolithography', 'Etching', 'Cleanroom', 'Glovebox'],
      },
      {
        label: 'Characterization',
        skills: ['SEM', 'Optical Microscopy', 'Raman Spectroscopy', 'EIS', 'Potentiostat', 'DSC', 'LVDT'],
      },
      {
        label: 'Materials Simulation',
        skills: ['OOF2', 'LAMMPS', 'Quantum ESPRESSO'],
      },
    ],
  },
];
---

<section class="ies note" id="skills" aria-labelledby="skills-title">
  <h2 id="skills-title">Technical Skills</h2>
  <table>
    {
      skillSets.map((set) => (
        <tbody>
          <tr class="ies__set">
            <th colspan="2" scope="rowgroup">{set.title}</th>
          </tr>
          {set.groups.map((group) => (
            <tr>
              <th scope="row">{group.label}</th>
              <td>
                {group.skills.map((skill) => (
                  <span>{skill}</span>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</section>
