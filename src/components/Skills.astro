---
const skillGroups = [
  {
    label: 'Languages & Tools',
    skills: ['Python', 'C++', 'Go', 'Erlang', 'TypeScript', 'PyTorch', 'React', 'Next.js', 'SQL', 'Bash'],
  },
  {
    label: 'Cloud & Infrastructure',
    skills: ['AWS', 'Docker', 'Kubernetes', 'CI/CD', 'Git / GitHub', 'RabbitMQ', 'REST API'],
  },
];
---

<section class="py-14 px-6 border-t border-zinc-800/50">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-xs font-mono text-zinc-600 uppercase tracking-widest mb-8">
      Technical Skills
    </h2>
    <div class="space-y-7">
      {
        skillGroups.map((group) => (
          <div>
            <div class="text-xs text-zinc-600 font-mono uppercase tracking-wider mb-3">
              {group.label}
            </div>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="text-sm text-zinc-300 px-3 py-1.5 bg-zinc-900/60 border border-zinc-800/70 rounded-lg font-mono hover:border-zinc-600 hover:text-zinc-100 transition-colors cursor-default">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
